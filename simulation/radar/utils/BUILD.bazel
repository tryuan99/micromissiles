load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "transforms",
    srcs = ["transforms.py"],
    deps = [requirement("numpy")],
)

py_test(
    name = "transforms_test",
    srcs = ["transforms_test.py"],
    deps = [
        ":transforms",
        requirement("absl-py"),
        requirement("numpy"),
    ],
)
