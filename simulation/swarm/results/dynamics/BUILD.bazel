load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "air_drag_terminal_velocity_main",
    srcs = ["air_drag_terminal_velocity_main.py"],
    data = ["//simulation/swarm/results/dynamics/data:air_drag_terminal_velocity_data"],
    deps = [
        "//simulation/swarm/utils/py:constants",
        "//utils/visualization:mpl_config",
        requirement("absl-py"),
        requirement("matplotlib"),
        requirement("numpy"),
        requirement("pandas"),
    ],
)

py_binary(
    name = "lift_induced_drag_turning_main",
    srcs = ["lift_induced_drag_turning_main.py"],
    data = ["//simulation/swarm/results/dynamics/data:lift_induced_drag_turning_data"],
    deps = [
        "//utils/visualization:mpl_config",
        requirement("absl-py"),
        requirement("matplotlib"),
        requirement("numpy"),
        requirement("pandas"),
    ],
)

py_binary(
    name = "total_drag_turning_main",
    srcs = ["total_drag_turning_main.py"],
    data = ["//simulation/swarm/results/dynamics/data:total_drag_turning_data"],
    deps = [
        "//simulation/swarm/utils/py:constants",
        "//utils/visualization:mpl_config",
        requirement("absl-py"),
        requirement("matplotlib"),
        requirement("numpy"),
        requirement("pandas"),
    ],
)
