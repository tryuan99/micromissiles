    deps = [
        ":antenna_array",
        "//utils:quaternion",
        requirement("absl-py"),
        requirement("numpy"),
    ],
)

py_binary(
    name = "antenna_array_radiation_pattern_main",
    srcs = ["antenna_array_radiation_pattern_main.py"],
