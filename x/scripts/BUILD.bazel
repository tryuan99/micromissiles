load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "antenna_sweep_main",
    srcs = ["antenna_sweep_main.py"],
    deps = [
        "//utils/devices:fieldfox_interface",
        "//utils/devices:pololu_tic_motor",
        requirement("absl-py"),
    ],
)

py_binary(
    name = "antenna_sweep_thorlabs_main",
    srcs = ["antenna_sweep_thorlabs_main.py"],
    deps = [
        "//utils/devices:fieldfox_interface",
        "//utils/devices:thorlabs_motor",
        requirement("absl-py"),
    ],
)

py_binary(
    name = "beamformer_sweep_main",
    srcs = ["beamformer_sweep_main.py"],
    deps = [
        "//utils/devices:fieldfox_interface",
        "//utils/serial:serial_interface",
        requirement("absl-py"),
    ],
)
