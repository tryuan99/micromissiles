module(name = "micromissiles")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

bazel_dep(
    name = "abseil-cpp",
    version = "20250814.1",
)
bazel_dep(
    name = "eigen",
    version = "5.0.0",
)
bazel_dep(
    name = "googletest",
    version = "1.17.0",
)
bazel_dep(
    name = "pico-sdk",
    version = "2.2.0",
)
bazel_dep(
    name = "platforms",
    version = "1.0.0",
)
bazel_dep(
    name = "protobuf",
    version = "32.1",
)
bazel_dep(
    name = "rules_cc",
    version = "0.2.9",
)
bazel_dep(
    name = "rules_foreign_cc",
    version = "0.15.1",
)
bazel_dep(
    name = "rules_pkg",
    version = "1.1.0",
)
bazel_dep(
    name = "rules_python",
    version = "1.6.3",
)

# Pico SDK toolchains.
register_toolchains(
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2040",
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:win-x86_64-rp2040",
    "@pico-sdk//bazel/toolchain:win-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2040",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2040",
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2350",
)

# Boost library.
BOOST_VERSION = "1.89.0"

http_archive(
    name = "boost",
    build_file = "//third_party/boost:boost.BUILD",
    sha256 = "9de758db755e8330a01d995b0a24d09798048400ac25c03fc5ea9be364b13c93",
    strip_prefix = "boost_{}".format(BOOST_VERSION.replace(".", "_")),
    url = "https://archives.boost.io/release/{}/source/boost_{}.tar.gz".format(
        BOOST_VERSION,
        BOOST_VERSION.replace(".", "_"),
    ),
)

# libmpc++ library.
LIBMPC_VERSION = "0.7.1"

http_archive(
    name = "libmpc",
    build_file = "//third_party/libmpc:libmpc.BUILD",
    sha256 = "587d6b0f97a64c54bb7df634325f1371b0950f04e362c2e6c11decd31a111e5a",
    strip_prefix = "libmpc-{}".format(LIBMPC_VERSION),
    url = "https://github.com/nicolapiccinelli/libmpc/archive/refs/tags/{}.tar.gz".format(LIBMPC_VERSION),
)

# NLopt library.
NLOPT_VERSION = "2.10.0"

http_archive(
    name = "nlopt",
    build_file = "//third_party/nlopt:nlopt.BUILD",
    sha256 = "506f83a9e778ad4f204446e99509cb2bdf5539de8beccc260a014bd560237be1",
    strip_prefix = "nlopt-{}".format(NLOPT_VERSION),
    url = "https://github.com/stevengj/nlopt/archive/refs/tags/v{}.tar.gz".format(NLOPT_VERSION),
)

# OpenCV library.
OPENCV_VERSION = "4.12.0"

http_archive(
    name = "opencv",
    build_file = "//third_party/opencv:opencv.BUILD",
    sha256 = "44c106d5bb47efec04e531fd93008b3fcd1d27138985c5baf4eafac0e1ec9e9d",
    strip_prefix = "opencv-{}".format(OPENCV_VERSION),
    url = "https://github.com/opencv/opencv/archive/refs/tags/{}.tar.gz".format(OPENCV_VERSION),
)

# OpenCV modules.
OPENCV_CONTRIB_VERSION = "4.12.0"

http_archive(
    name = "opencv_contrib",
    build_file = "//third_party/opencv_contrib:opencv_contrib.BUILD",
    sha256 = "4197722b4c5ed42b476d42e29beb29a52b6b25c34ec7b4d589c3ae5145fee98e",
    strip_prefix = "opencv_contrib-{}".format(OPENCV_CONTRIB_VERSION),
    url = "https://github.com/opencv/opencv_contrib/archive/refs/tags/{}.tar.gz".format(OPENCV_CONTRIB_VERSION),
)

# OSQP library.
OSQP_VERSION = "1.0.0"

http_archive(
    name = "osqp",
    build_file = "//third_party/osqp:osqp.BUILD",
    sha256 = "dd6a1c2e7e921485697d5e7cdeeb043c712526c395b3700601f51d472a7d8e48",
    strip_prefix = "osqp-{}".format(OSQP_VERSION),
    url = "https://github.com/osqp/osqp/archive/refs/tags/v{}.tar.gz".format(OSQP_VERSION),
)

# Configure the Python toolchain.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Load pip dependencies.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//deps:requirements.txt",
)
use_repo(pip, "pypi")
