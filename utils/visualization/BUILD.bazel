load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "animator",
    srcs = ["animator.py"],
    deps = [
        ":mpl_config",
        requirement("matplotlib"),
    ],
)

py_library(
    name = "color_maps",
    srcs = ["color_maps.py"],
    deps = [
        requirement("matplotlib"),
        requirement("numpy"),
    ],
)

py_library(
    name = "mpl_config",
    srcs = ["mpl_config.py"],
    deps = [requirement("matplotlib")],
)
