        ":clusterer",
        requirement("numpy"),
        requirement("scipy"),
    ],
)

py_test(
    name = "k_means_clusterer_test",
    srcs = ["k_means_clusterer_test.py"],
    deps = [
        ":clusterer",
        ":k_means_clusterer",
        requirement("absl-py"),
        requirement("numpy"),
    ],
)

py_binary(
    name = "k_means_clusterer_main",
    srcs = ["k_means_clusterer_main.py"],
    deps = [
        ":clusterer",
        ":k_means_clusterer",
        requirement("absl-py"),
        requirement("matplotlib"),
        requirement("numpy"),
        requirement("SciencePlots"),
    ],
)

py_library(
