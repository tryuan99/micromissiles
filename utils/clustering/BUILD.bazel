load("@pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "agglomerative_clusterer",
    srcs = ["agglomerative_clusterer.py"],
    deps = [
        ":clusterer",
        requirement("numpy"),
        requirement("scipy"),
    ],
)

py_test(
    name = "agglomerative_clusterer_test",
    srcs = ["agglomerative_clusterer_test.py"],
    deps = [
        ":agglomerative_clusterer",
        ":clusterer",
        requirement("absl-py"),
        requirement("numpy"),
    ],
)

py_library(
    name = "clusterer",
    srcs = ["clusterer.py"],
    deps = [requirement("numpy")],
)

py_test(
    name = "clusterer_test",
    srcs = ["clusterer_test.py"],
    deps = [
        ":clusterer",
        requirement("absl-py"),
        requirement("numpy"),
    ],
)

py_library(
    name = "k_means_clusterer",
