load("@pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "constants",
    srcs = ["constants.py"],
    deps = [requirement("numpy")],
)

py_library(
    name = "coordinates",
    srcs = ["coordinates.py"],
    deps = [requirement("numpy")],
)

py_test(
    name = "coordinates_test",
    srcs = ["coordinates_test.py"],
    deps = [
        ":coordinates",
        requirement("absl-py"),
        requirement("numpy"),
    ],
)

cc_library(
    name = "protobuf",
    hdrs = ["protobuf.h"],
    deps = [
        "@abseil-cpp//absl/strings:str_format",
        "@protobuf",
    ],
)

cc_test(
    name = "protobuf_test",
    srcs = ["protobuf_test.cc"],
    data = ["//simulation/swarm/configs/interceptor:configs"],
    deps = [
        ":protobuf",
        "//simulation/swarm/proto:static_config_cc_proto",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

py_library(
    name = "quaternion",
    srcs = ["quaternion.py"],
    deps = [requirement("numpy")],
)

py_test(
    name = "quaternion_test",
    srcs = ["quaternion_test.py"],
    deps = [
        ":quaternion",
        requirement("absl-py"),
        requirement("numpy"),
        requirement("scipy"),
    ],
)

cc_library(
    name = "random",
    srcs = ["random.cc"],
    hdrs = ["random.h"],
)

py_library(
    name = "struct",
    srcs = ["struct.py"],
)

py_test(
    name = "struct_test",
    srcs = ["struct_test.py"],
    deps = [
        ":struct",
        requirement("absl-py"),
    ],
)

cc_library(
    name = "thread_pool",
    srcs = ["thread_pool.cc"],
    hdrs = ["thread_pool.h"],
)

cc_test(
    name = "thread_pool_test",
    srcs = ["thread_pool_test.cc"],
    deps = [
        ":thread_pool",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
